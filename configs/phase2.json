{
  "seed": 20261107,
  "phase": 2,
  "task": "multiclass text classification",
  "target_variable": "Issue",
  "input_feature": "Consumer complaint narrative",
  "sample_frame": "records with non-empty narrative AND non-empty Issue",
  "sample_size": 40000,
  "sampling": "seeded reservoir sampling over the full file, single pass",
  "split": {
    "type": "temporal on Date received, whole calendar days kept together",
    "train": 0.70,
    "val": 0.15,
    "test": 0.15,
    "test_used_once": true
  },
  "min_class_support": 20,
  "rare_class_policy": "collapse to __OTHER__",
  "primary_metric": "macro-F1",
  "secondary_metrics": ["balanced accuracy", "per-class recall", "accuracy",
                        "groundedness", "abstention rate", "output variability"],
  "bootstrap_repeats": 500,
  "llm_eval_n": 400,
  "post_hoc_fields_excluded_from_features": [
    "Company public response",
    "Date sent to company",
    "Company response to consumer",
    "Timely response?"
  ],
  "sensitive_fields_audit_only": ["Tags", "ZIP code"],
  "notes": "Every number in the report is regenerated by src/run_all.py. Do not edit results/*.csv by hand."
}
